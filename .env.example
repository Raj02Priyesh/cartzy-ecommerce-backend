# Copy this file to .env and fill in your own values. Never commit .env.

# Server
PORT=5000

# MongoDB connection string (e.g. a free MongoDB Atlas M0 cluster)
MONGO_URI=

# Secret used to sign login tokens - use a long random string
JWT_SECRET=

# Key required to create an admin account via POST /api/admin/auth/signup
ADMIN_KEY=

# Optional: comma-separated list of browser origins allowed to call the API (default: any origin)
# CORS_ORIGINS=https://raj02priyesh.github.io,http://localhost:8080

# AWS S3 for product/category/banner image uploads
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
